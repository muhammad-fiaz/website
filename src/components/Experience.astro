---
interface ExperienceItem {
	title: string;
	company?: string;
	location?: string;
	type?: string;
	period: string;
	color: string;
	link?: string;
	description: string;
}

const experiences: ExperienceItem[] = [
	/*
	{
		title: '',
		company: '',
		location: '',
		type: '',
		period: '',
		color: 'green',
		link: '',
		description: ``
	}
	*/
];
---

<style>
	@keyframes green-pulse {
		0%,
		100% {
			background-color: rgb(74 222 128); /* green-400 */
			box-shadow:
				0 10px 15px -3px rgba(74, 222, 128, 0.5),
				0 4px 6px -2px rgba(74, 222, 128, 0.5);
		}
		50% {
			background-color: rgb(34 197 94); /* green-500 */
			box-shadow:
				0 10px 15px -3px rgba(34, 197, 94, 0.8),
				0 4px 6px -2px rgba(34, 197, 94, 0.8);
		}
	}

	.green-pulse {
		animation: green-pulse 2s ease-in-out infinite;
	}
</style>

<section class='mb-8 lg:min-h-screen' id='experience'>
	<h2 class='text-2xl sm:text-3xl font-bold mb-2 text-center'>Experience</h2>
	<p class='mb-6 text-center'>
		I’ve had the opportunity to gain valuable experience as a software developer, both as a freelancer and as an open-source contributor.
		Below is a summary of my work and the skills I've developed along the way.
	</p>
	<div class='relative'>
		<!-- Main vertical line -->
		<div class='absolute left-6 sm:left-1/2 w-0.5 bg-gray-300 dark:bg-gray-600 h-full'></div>

		<div class='space-y-6 sm:space-y-8'>
			{
				experiences.map((exp, idx) => {
					return (
						<div class={`relative flex items-start sm:items-center`}>
							{/* Circle indicator */}
							<div class='absolute left-4 sm:left-1/2 transform sm:-translate-x-1/2 z-10 mt-1 sm:mt-0'>
								<div
									class={`w-4 h-4 sm:w-6 sm:h-6 rounded-full border-2 sm:border-4 border-white dark:border-gray-900 ${exp.color === 'green' ? 'bg-green-400 green-pulse' : 'bg-zinc-400 shadow-md'}`}
								/>
							</div>
							{/* Content */}
							<div class={`w-full pl-12 sm:w-1/2 ${idx % 2 === 1 ? 'sm:pr-8 sm:text-right sm:pl-0' : 'sm:ml-auto sm:pl-8'}`}>
								<time class='font-mono italic text-xs sm:text-sm'>{exp.period}</time>
								{exp.link ? (
									<a href={exp.link} target='_blank' rel='noopener' class='block group focus:outline-none'>
										<div class={`text-base sm:text-lg font-black group-hover:underline group-focus:underline`}>
											{exp.title}
											{exp.company || exp.type || exp.location ? (
												<span class='font-normal text-gray-700 dark:text-gray-300'>
													{exp.company ? ` · ${exp.company}` : ''}
													{exp.type ? ` · ${exp.type}` : ''}
													{exp.location ? ` · ${exp.location}` : ''}
												</span>
											) : null}
										</div>
										<p class='mt-1 sm:mt-2 text-sm sm:text-base'>{exp.description}</p>
									</a>
								) : (
									<>
										<div class={`text-base sm:text-lg font-black`}>
											{exp.title}
											{exp.company || exp.type || exp.location ? (
												<span class='font-normal text-gray-700 dark:text-gray-300'>
													{exp.company ? ` · ${exp.company}` : ''}
													{exp.type ? ` · ${exp.type}` : ''}
													{exp.location ? ` · ${exp.location}` : ''}
												</span>
											) : null}
										</div>
										<p class='mt-1 sm:mt-2 text-sm sm:text-base'>{exp.description}</p>
									</>
								)}
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
